# Aerastro 3D v0.4.0 — public client configuration only.
# Copy to .env.local AFTER creating your own Supabase project.
# Never commit .env.local; NEVER place service_role or OAuth client secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Proposed deployment host (reserve and confirm on Cloudflare first).
VITE_PUBLIC_SITE_URL=https://aerastro3d.pages.dev
