# Aerastro 3D v0.4.0 — public client configuration only.
# Copy to .env.local AFTER creating your own Supabase project.
# Never commit .env.local; NEVER place service_role or OAuth client secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Vite build base path: use / on Cloudflare Workers, and /3d-web-platform/ on GitHub Pages.
# Configure VITE_SITE_BASE=/ in Cloudflare Workers Build variables; do not commit private keys.
VITE_SITE_BASE=/
# Confirmed Cloudflare Workers deployment URL (not pages.dev):
VITE_PUBLIC_SITE_URL=https://aerastro3d.hoangnguyen-artist.workers.dev
